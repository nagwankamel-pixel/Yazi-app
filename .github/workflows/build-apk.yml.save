name: Build YAZI APK






# Runs when you press "Run workflow" on the Actions tab, and on every push.
on:
  workflow_dispatch:
    inputs:
      api_base:
        description: 'Backend API base URL'
        required: true
        default: 'http://164.92.167.224:8787/api/v1'
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.32.6'
          channel: stable

      # The handover zip was missing the Android manifest / MainActivity /
      # resource folders, so regenerate the standard Android scaffolding.
      # This only fills in what is absent; lib/, assets/ and pubspec are untouched.
      - name: Restore Android project files
        run: flutter create --platforms=android --project-name yozi_app --org com.yozi .

      # The backend is plain HTTP, which Android blocks by default.
      - name: Allow HTTP traffic to the API
        run: |
          MANIFEST=android/app/src/main/AndroidManifest.xml
          grep -q 'usesCleartextTraffic' $MANIFEST || \
            sed -i 's|<application|<application\n        android:usesCleartextTraffic="true"|' $MANIFEST
          sed -i 's|android:label="[^"]*"|android:label="YAZI"|' $MANIFEST
          cat $MANIFEST

      - name: Install dependencies
        run: flutter pub get

      - name: Generate launcher icons
        run: dart run flutter_launcher_icons || echo "icon generation skipped"

      - name: Analyze (warnings only, does not stop the build)
        run: flutter analyze || true

      - name: Build release APK
        run: |
          flutter build apk --release \
            --dart-define=YAZI_API=${{ github.event.inputs.api_base || 'http://164.92.167.224:8787/api/v1' }}

      - name: Rename APK
        run: |
          mkdir -p out
          cp build/app/outputs/flutter-apk/app-release.apk "out/YAZI-$(date +%Y%m%d-%H%M).apk"
          ls -la out

      - uses: actions/upload-artifact@v4
        with:
          name: YAZI-apk
          path: out/*.apk
          retention-days: 30
